# Copy this file to `.env` in the project root for local development.
# Lovable manages the real `.env` automatically in the cloud editor —
# you only need this file when running the app from VS Code locally.

# ---- Public (browser-safe) ----
# Found in Lovable: Cloud → Settings, or copy from the cloud `.env`.
VITE_SUPABASE_URL="https://upibokvyfccvzvnddexg.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="upibokvyfccvzvnddexg"

# ---- Server-only (never expose to browser) ----
# Same URL/anon key, also read by server functions during SSR.
SUPABASE_URL="https://upibokvyfccvzvnddexg.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Service role key — bypasses RLS. Cloud → Connectors → Lovable Cloud → API keys.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Admin password gate for /admin/bookings (you set this when adding the secret).
ADMIN_PASSWORD="your-admin-password"

# Gmail connector token used by the booking notification email.
# Get from Lovable: Connectors → Gmail → View secrets.
GOOGLE_MAIL_API_KEY="your-gmail-connector-token"

# Lovable AI Gateway key (only needed if you use Lovable AI features locally).
LOVABLE_API_KEY="your-lovable-api-key"